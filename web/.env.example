# Copy to web/.env.local and fill in from Firebase console → Project settings → Your apps → Web app.
# Leave these empty to run in rules-only mode ("AI not configured").
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check with reCAPTCHA Enterprise (Firebase console → App Check → your web app).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# In `npm run dev` the App Check debug provider is always on; the debug token is printed
# in the browser console the first time. Register it in Firebase console → App Check → Manage debug tokens.
# Set to true to also use the debug provider in a production build (local testing only).
VITE_APPCHECK_DEBUG=false

# Hosted web app URL (e.g. https://<project>.web.app). Family invite links made in the extension point here.
VITE_PUBLIC_APP_URL=

# Chrome extension only: Google sign-in via chrome.identity. Create an OAuth client of type
# "Chrome extension" in Google Cloud console for your extension id, and paste its client id here.
VITE_GOOGLE_OAUTH_CLIENT_ID=
# Optional: the extension's public key (from chrome://extensions → Pack, or the Web Store), so the
# extension id stays fixed for the OAuth client above.
VITE_EXTENSION_KEY=
